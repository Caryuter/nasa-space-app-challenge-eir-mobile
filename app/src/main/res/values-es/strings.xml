    <!-- SOS Scenarios & Steps -->
    <string name="sos_faint_title">Alguien se mareó o desmayó</string>
    <string name="sos_faint_kit">Estuche Azul (Cruz Blanca) • Pinza de dedo + Botella electrolitos</string>
    <string name="sos_faint_step1_instruction">Sujétalo al asiento con el cinturón</string>
    <string name="sos_faint_step1_why">Evita que flote y golpee los paneles en gravedad cero.</string>
    <string name="sos_faint_step1_kit">Arnés de pecho y cintura</string>
    <string name="sos_faint_step2_instruction">Coloca la pinza blanca en su dedo</string>
    <string name="sos_faint_step2_why">Nos dirá en 5 segundos si le está llegando suficiente oxígeno.</string>
    <string name="sos_faint_step2_kit">Pinza de oximetría (Estuche Azul)</string>
    <string name="sos_faint_step3_instruction">Dale pequeños sorbos de agua con sales</string>
    <string name="sos_faint_step3_why">En microgravedad los líquidos restablecen la presión arterial.</string>
    <string name="sos_faint_step3_kit">Bolsa de sales con boquilla naranja</string>
    <string name="sos_faint_step4_instruction">Déjalo descansar quieto 10 minutos</string>
    <string name="sos_faint_step4_why">El sistema circulatorio necesita tiempo para reestabilizarse.</string>
    <string name="sos_faint_step4_kit">Luz suave y acompañamiento</string>

    <string name="sos_chest_title">Dolor fuerte en el pecho</string>
    <string name="sos_chest_kit">Maletín Rojo Principal • Parches cardíacos y pastilla sublingual</string>
    <string name="sos_chest_step1_instruction">Detén cualquier esfuerzo y abróchalo al asiento</string>
    <string name="sos_chest_step1_why">El corazón necesita consumir la menor energía posible ahora mismo.</string>
    <string name="sos_chest_step1_kit">Asiento de cabina con arnés holgado</string>
    <string name="sos_chest_step2_instruction">Pídele que respire lento y profundo</string>
    <string name="sos_chest_step2_why">Inhala 4 segundos, exhala 6 segundos para calmar los latidos.</string>
    <string name="sos_chest_step2_kit">Conteo guiado y respiración pausada</string>
    <string name="sos_chest_step3_instruction">Abre el Maletín Rojo y prepara los parches</string>
    <string name="sos_chest_step3_why">Monitorea el ritmo cardíaco si el dolor no cede en 5 minutos.</string>
    <string name="sos_chest_step3_kit">Parches cardíacos (Maletín Rojo)</string>

    <string name="sos_cut_title">Corte o golpe con sangrado</string>
    <string name="sos_cut_kit">Bolsa Verde • Gasas absorbentes selladas y venda elástica</string>
    <string name="sos_cut_step1_instruction">Presiona la herida con gasa gruesa sin soltar</string>
    <string name="sos_cut_step1_why">En gravedad cero la sangre no cae: forma burbujas y no coagula bien.</string>
    <string name="sos_cut_step1_kit">Gasas absorbentes (Bolsa Verde)</string>
    <string name="sos_cut_step2_instruction">Mantén presión firme por 3 minutos seguidos</string>
    <string name="sos_cut_step2_why">Levantar la gasa antes de tiempo rompe el coágulo en formación.</string>
    <string name="sos_cut_step2_kit">Compresión continua sin levantar el apósito</string>
    <string name="sos_cut_step3_instruction">Envuelve con la venda elástica autoadhesiva</string>
    <string name="sos_cut_step3_why">Fija el vendaje asegurando que los dedos sigan tibios y con flujo.</string>
    <string name="sos_cut_step3_kit">Rollo elástico azul (Bolsa Verde)</string>

    <string name="sos_breath_title">Falta de aire o ahogo</string>
    <string name="sos_breath_kit">Panel Lateral • Mascarilla transparente de oxígeno</string>
    <string name="sos_breath_step1_instruction">Coloca la mascarilla y gira la válvula verde</string>
    <string name="sos_breath_step1_why">Suministra flujo de oxígeno puro directo a nariz y boca.</string>
    <string name="sos_breath_step1_kit">Mascarilla de oxígeno (Panel Lateral)</string>
    <string name="sos_breath_step2_instruction">Enciende el ventilador portátil hacia su rostro</string>
    <string name="sos_breath_step2_why">En microgravedad el CO₂ exhalado se queda flotando frente a la cara.</string>
    <string name="sos_breath_step2_kit">Interruptor azul de flujo de cabina</string>
    <string name="sos_breath_step3_instruction">Afloja el cuello de su traje espacial</string>
    <string name="sos_breath_step3_why">Libera la vía respiratoria y alivia la sensación de ahogo.</string>
    <string name="sos_breath_step3_kit">Cierre y sellos del cuello</string>
