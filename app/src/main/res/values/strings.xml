    <!-- SOS Scenarios & Steps -->
    <string name="sos_faint_title">Someone feels dizzy or fainted</string>
    <string name="sos_faint_kit">Blue Case (White Cross) • Finger clip + Electrolyte bottle</string>
    <string name="sos_faint_step1_instruction">Secure them to the seat with the belt</string>
    <string name="sos_faint_step1_why">Prevents floating and hitting panels in zero gravity.</string>
    <string name="sos_faint_step1_kit">Chest and waist harness</string>
    <string name="sos_faint_step2_instruction">Place the white clip on their finger</string>
    <string name="sos_faint_step2_why">Tells us in 5 seconds if enough oxygen is being delivered.</string>
    <string name="sos_faint_step2_kit">Oximetry clip (Blue Case)</string>
    <string name="sos_faint_step3_instruction">Give small sips of water with electrolytes</string>
    <string name="sos_faint_step3_why">In microgravity fluids restore blood pressure.</string>
    <string name="sos_faint_step3_kit">Electrolyte pouch with orange nozzle</string>
    <string name="sos_faint_step4_instruction">Let them rest still for 10 minutes</string>
    <string name="sos_faint_step4_why">The circulatory system needs time to restabilize.</string>
    <string name="sos_faint_step4_kit">Soft lighting and monitoring</string>

    <string name="sos_chest_title">Severe chest pain</string>
    <string name="sos_chest_kit">Main Red Kit • Cardiac pads and sublingual tablet</string>
    <string name="sos_chest_step1_instruction">Stop any effort and fasten them to the seat</string>
    <string name="sos_chest_step1_why">The heart needs to consume as little energy as possible right now.</string>
    <string name="sos_chest_step1_kit">Cabin seat with loose harness</string>
    <string name="sos_chest_step2_instruction">Ask them to breathe slow and deep</string>
    <string name="sos_chest_step2_why">Inhale 4 seconds, exhale 6 seconds to calm heartbeat.</string>
    <string name="sos_chest_step2_kit">Guided counting and slow breathing</string>
    <string name="sos_chest_step3_instruction">Open Red Kit and prepare the patches</string>
    <string name="sos_chest_step3_why">Monitors heart rhythm if pain does not subside within 5 minutes.</string>
    <string name="sos_chest_step3_kit">Cardiac patches (Red Kit)</string>

    <string name="sos_cut_title">Cut or impact with bleeding</string>
    <string name="sos_cut_kit">Green Bag • Sealed absorbent gauze and elastic bandage</string>
    <string name="sos_cut_step1_instruction">Press wound firmly with thick gauze without releasing</string>
    <string name="sos_cut_step1_why">In zero gravity blood does not drip: it forms bubbles and clots slowly.</string>
    <string name="sos_cut_step1_kit">Absorbent gauze (Green Bag)</string>
    <string name="sos_cut_step2_instruction">Maintain firm pressure for 3 continuous minutes</string>
    <string name="sos_cut_step2_why">Lifting gauze early breaks the forming clot.</string>
    <string name="sos_cut_step2_kit">Continuous compression without lifting dressing</string>
    <string name="sos_cut_step3_instruction">Wrap with self-adhesive elastic bandage</string>
    <string name="sos_cut_step3_why">Secures dressing ensuring fingers remain warm with circulation.</string>
    <string name="sos_cut_step3_kit">Blue elastic roll (Green Bag)</string>

    <string name="sos_breath_title">Shortness of breath or choking</string>
    <string name="sos_breath_kit">Side Panel • Transparent oxygen mask</string>
    <string name="sos_breath_step1_instruction">Place mask and turn the green valve</string>
    <string name="sos_breath_step1_why">Delivers direct pure oxygen flow to nose and mouth.</string>
    <string name="sos_breath_step1_kit">Oxygen mask (Side Panel)</string>
    <string name="sos_breath_step2_instruction">Aim portable fan towards their face</string>
    <string name="sos_breath_step2_why">In microgravity exhaled CO₂ stays floating in front of the face.</string>
    <string name="sos_breath_step2_kit">Blue cabin airflow switch</string>
    <string name="sos_breath_step3_instruction">Loosen the collar of their spacesuit</string>
    <string name="sos_breath_step3_why">Clears airway and relieves choking sensation.</string>
    <string name="sos_breath_step3_kit">Collar seals and closure</string>
